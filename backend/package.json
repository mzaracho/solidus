    "@nestjs/platform-express": "^10.0.0",
    "@nestjs/swagger": "^11.2.5",
    "@prisma/client": "^5.22.0",
    "@types/bcrypt": "^6.0.0",
    "axios": "^1.13.2",
    "bcrypt": "^6.0.0",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.3",
    "reflect-metadata": "^0.2.0",
    "rxjs": "^7.8.1",
