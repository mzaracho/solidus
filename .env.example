# Configuración local. Copiar a .env (no se versiona) o dejar que .\dev.ps1 lo cree.
# Es la ÚNICA fuente de credenciales: dev.ps1 genera backend/.env a partir de este archivo.
# Lo leen docker compose (raíz) y dev.ps1.
POSTGRES_USER=change-me
POSTGRES_PASSWORD=change-me
POSTGRES_DB=solidus_db
# Mínimo 32 caracteres. dev.ps1 lo genera al crear el .env. A mano:
# node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=change-me
# URL de la API vista desde el navegador en modo Docker (se hornea al construir el frontend).
# Para usar el frontend desde otro equipo de la red, poner la IP de esta PC y correr .\dev.ps1 -Docker.
NEXT_PUBLIC_API_BASE_URL=http://localhost:8080/api
# Interfaz donde se publican la API (8080) y el frontend (3001) en modo Docker. Por defecto solo esta PC
# (127.0.0.1). Postgres (5433) SIEMPRE queda en 127.0.0.1, sin importar este valor.
# Para entrar desde otros dispositivos de la red local, descomentar y poner 0.0.0.0; en ese caso ajustar
# tambien NEXT_PUBLIC_API_BASE_URL a la IP de esta PC y correr .\dev.ps1 -Docker. Usar solo en redes de confianza.
# BIND_ADDRESS=127.0.0.1
# Prueba de humo (.\dev.ps1 -Smoke): usuario de prueba de la base local. Vacíos = se saltea el login.
SMOKE_USER=
SMOKE_PASSWORD=
# Puerto del frontend en modo desarrollo (.\dev.ps1). Por defecto 3000. Si el 3000 esta ocupado por otro
# proyecto, descomentar y poner otro (entero entre 1024 y 65535, distinto de 5433 y 8080), por ejemplo 3005.
# No afecta al modo Docker, que publica el frontend siempre en 3001.
# FRONTEND_PORT=3000
